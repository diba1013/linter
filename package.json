{
	"name": "@diba1013/linter",
	"version": "0.0.0-development",
	"description": "The missing linter configurations for personal use.",
	"license": "MIT",
	"repository": {
		"url": "git+https://github.com/diba1013/linter.git"
	},
	"author": "diba1013",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"files": [
		"src"
	],
	"exports": {
		".": "./src/index.js",
		"./eslint": "./src/recommended.eslint.js",
		"./prettier": "./src/recommended.prettier.js"
	},
	"main": "./src/index.js",
	"scripts": {
		"prepare": "husky",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix ."
	},
	"peerDependencies": {
		"eslint": "10.x",
		"prettier": "3.x"
	},
	"dependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@eslint/json": "2.1.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-perfectionist": "5.12.1",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-unicorn": "78.0.0",
		"eslint-plugin-vue": "10.11.1",
		"eslint-plugin-yml": "3.9.0",
		"globals": "17.13.0",
		"typescript-eslint": "8.71.2",
		"vue-eslint-parser": "10.4.1"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@diba1013/linter": "workspace:*",
		"@types/node": "26.6.5",
		"baseline-browser-mapping": "2.11.29",
		"eslint": "10.12.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"semantic-release": "25.0.9",
		"typescript": "6.0.3"
	}
}
